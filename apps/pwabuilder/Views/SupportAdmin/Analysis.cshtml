@model PWABuilder.Models.SupportAnalysis
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Analysis diagnostics</title></head>
<body>
<main>
    <a href="/admin">Recent failures</a>
    <h1>Analysis diagnostics</h1>
    <dl>
        <dt>Reference</dt><dd>@Model.Id</dd>
        <dt>Site origin</dt><dd>@Model.SiteOrigin</dd>
        <dt>Status</dt><dd>@Model.Status</dd>
        <dt>Created (UTC)</dt><dd>@Model.CreatedAt.ToString("u")</dd>
        <dt>Updated (UTC)</dt><dd>@Model.UpdatedAt.ToString("u")</dd>
        <dt>Failure</dt><dd>@Model.FailureSummary</dd>
    </dl>
    <h2>Redacted failure detail</h2>
    @if (Model.Error.Length == 0) { <p>No error detail available.</p> }
    else { <pre>@Model.Error</pre> }
    <h2>Redacted processing logs</h2>
    <p>Up to 100 entries, 4,000 characters each. Sensitive values and URL-private components are removed.</p>
    <ol>
    @foreach (var log in Model.Logs)
    {
        <li><pre>@log</pre></li>
    }
    </ol>
    <h2>Structured checks</h2>
    <p>Check outcomes only. Manifests and raw capability error text are not displayed.</p>
    <table>
        <thead><tr><th scope="col">Check</th><th scope="col">Outcome</th></tr></thead>
        <tbody>
        @foreach (var check in Model.Checks)
        {
            <tr><td>@check.Id</td><td>@check.Status</td></tr>
        }
        </tbody>
    </table>
</main>
</body>
</html>
