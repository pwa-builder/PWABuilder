@model PWABuilder.Models.SupportPackage
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Google Play diagnostics</title></head>
<body>
<main>
    <a href="/admin">Recent failures</a>
    <h1>Google Play diagnostics</h1>
    <dl>
        <dt>Support reference</dt><dd>@Model.SupportReference</dd>
        <dt>Site origin</dt><dd>@Model.SiteOrigin</dd>
        <dt>Status</dt><dd>@Model.Status</dd>
        <dt>Created (UTC)</dt><dd>@Model.CreatedAt.ToString("u")</dd>
        <dt>Updated (UTC)</dt><dd>@Model.UpdatedAt.ToString("u")</dd>
        <dt>Retries</dt><dd>@Model.RetryCount</dd>
        <dt>App name</dt><dd>@Model.Configuration.Name</dd>
        <dt>Package ID</dt><dd>@Model.Configuration.PackageId</dd>
        <dt>Version</dt><dd>@Model.Configuration.AppVersion</dd>
        <dt>Version code</dt><dd>@Model.Configuration.AppVersionCode</dd>
        <dt>Minimum SDK</dt><dd>@Model.Configuration.MinSdkVersion</dd>
        <dt>Signing mode</dt><dd>@Model.Configuration.SigningMode</dd>
        <dt>Uploaded key supplied</dt><dd>@Model.Configuration.HasUploadedKey</dd>
        <dt>Key password supplied</dt><dd>@Model.Configuration.HasKeyPassword</dd>
        <dt>Store password supplied</dt><dd>@Model.Configuration.HasStorePassword</dd>
        <dt>Failure</dt><dd>@Model.FailureSummary</dd>
    </dl>
    <h2>Observed processing stages</h2>
    <p>Signing material and package artifacts are never available here.</p>
    <ul>
    @foreach (var stage in Model.Stages)
    {
        <li>@stage</li>
    }
    </ul>
    <h2>Redacted errors</h2>
    <p>Up to 20 errors and 100 log entries, 4,000 characters each. Sensitive values and URL-private components are removed.</p>
    <ol>
    @foreach (var error in Model.Errors)
    {
        <li><pre>@error</pre></li>
    }
    </ol>
    <h2>Redacted processing logs</h2>
    <ol>
    @foreach (var log in Model.Logs)
    {
        <li><pre>@log</pre></li>
    }
    </ol>
</main>
</body>
</html>
