{
  "name": "pwa-demo",
  "version": "1.0.0",
  "description": "Nimbus - an offline-first pocket studio PWA that showcases the modern web platform. Built with the PWABuilder pwa-starter.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "copy-icons": "node scripts/copy-icons.mjs",
    "build": "node scripts/copy-icons.mjs && tsc && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "start-remote": "vite --host"
  },
  "author": "PWABuilder",
  "license": "MIT",
  "dependencies": {
    "@awesome.me/webawesome": "^3.10.0",
    "lit": "^3.3.3",
    "urlpattern-polyfill": "^10.1.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "sharp": "^0.34.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "consistent",
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "bracketSpacing": true
  }
}
