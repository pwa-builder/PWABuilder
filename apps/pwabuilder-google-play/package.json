{
    "name": "@pwabuilder/cloudapk",
    "version": "1.1.0",
    "description": "Web service that packages a Progressive Web App as an Android Trusted Web Activity app for publishing in the Google Play Store.",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node ./server.js",
        "postinstall": "tsc",
        "dev": "cross-env NODE_ENV=development node --inspect=5858 --loader ts-node/esm ./server.ts",
        "build": "tsc --noEmitOnError",
        "docker:build": "npm run build && docker build -t cloud-apk .",
        "docker:run": "docker run -p 5779:5858 -e NODE_ENV=development cloud-apk"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pwa-builder/pwabuilder-google-play.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/pwa-builder/pwabuilder/issues"
    },
    "homepage": "https://github.com/pwa-builder/pwabuilder-google-play/",
    "dependencies": {
        "@azure/identity": "^4.13.1",
        "@azure/monitor-opentelemetry": "^1.18.2",
        "@azure/storage-blob": "^12.29.0",
        "@azure/storage-queue": "^12.29.0",
        "@bubblewrap/core": "^1.24.1",
        "@opentelemetry/api": "^1.9.0",
        "@redis/client": "^5.10.0",
        "@redis/entraid": "^5.10.0",
        "archiver": "^8.0.0",
        "body-parser": "^1.20.6",
        "cors": "^2.8.5",
        "del": "^8.0.1",
        "dotenv": "^16.6.1",
        "escape-html": "^1.0.3",
        "express": "^4.22.2",
        "fs-extra": "^11.3.3",
        "node-fetch": "^3.3.2",
        "password-generator": "^2.3.2",
        "path": "^0.12.7",
        "tmp": "^0.2.7"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/cors": "^2.8.19",
        "@types/escape-html": "^1.0.4",
        "@types/express": "^4.17.25",
        "@types/express-fileupload": "^1.5.1",
        "@types/fs-extra": "^11.0.4",
        "@types/tmp": "^0.2.6",
        "cross-env": "^10.1.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "tough-cookie": ">=4.1.3",
        "protobufjs": ">=7.3.2",
        "form-data": "4.0.6",
        "uuid": "11.1.1",
        "node-forge": ">=0.7.2",
        "qs": ">=6.3.2",
        "path-parse": ">=1.0.7",
        "async": ">=3.2.2",
        "minimatch": ">=3.0.2",
        "tar": ">=7.5.20"
    }
}