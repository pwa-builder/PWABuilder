{
  "name": "pwa-builder-blog",
  "version": "1.0.0",
  "description": "PWA Builder Blogging site",
  "license": "MIT",
  "engines": {
    "node": ">=20.5.0"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production npm-run-all clean -p build:*",
    "build:blog": "eleventy",
    "build:rollup": "rollup -c",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "npm-run-all clean build:* -p dev:*",
    "dev": "npm-run-all clean build:* -p dev:*",
    "dev:11ty": "eleventy --serve --quiet",
    "dev:rollup": "rollup -c -w"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^1.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.0.0",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@tailwindcss/forms": "^0.5.2",
    "autoprefixer": "^10.4.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.1",
    "markdown-it": "^14.2.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.20",
    "postcss-import": "^14.1.0",
    "postcss-nested": "^5.0.6",
    "prettier": "^2.6.2",
    "rollup": "^2.80.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^3.0.24"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "markdown-it-implicit-figures": "^0.12.0"
  },
  "overrides": {
    "@11ty/recursive-copy": {
      ".": "5.0.0",
      "minimatch": {
        ".": "10.2.5",
        "brace-expansion": "npm:@isaacs/brace-expansion@5.0.1"
      }
    }
  }
}
